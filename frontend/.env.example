# Frontend Environment Variables
# Copy this file to .env.local and update the values

# Backend API URLs (for API proxying)
# 🔧 NEW: Unified Backend URL for authentication
UNIFIED_BACKEND_URL=http://localhost:8000

# Legacy backend URLs (maintain compatibility)
BACKEND_PRO1_URL=http://localhost:8000
BACKEND_PRO2_URL=http://localhost:8100
BACKEND_DATA_URL=http://localhost:8001

# Data Service URL (for data management APIs)
DATA_SERVICE_URL=http://localhost:8001

# Frontend API Base URL (used by the frontend API clients)
NEXT_PUBLIC_API_URL=/api

# Other environment variables
NEXT_PUBLIC_APP_NAME=SaaS Control Deck
NEXT_PUBLIC_APP_DESCRIPTION=AI-Powered Data Analysis Platform